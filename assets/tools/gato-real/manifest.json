{
  "manifest_version": 3,
  "name": "Gato das Horas",
  "version": "2.1.0",
  "description": "Um gato para acompanhar as tuas horas extra de trabalho.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Gato das Horas",
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" }
  },
  "icons": { "16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core.js", "cat-names.js", "cats.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["assets/mascot/*", "assets/cats/*", "assets/magical_cats/*"], "matches": ["<all_urls>"] }
  ]
}
